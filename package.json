{
  "name": "pptx-font-locator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "npm run fixtures",
    "dev": "vite --host 127.0.0.1 --port 4315 --strictPort",
    "prebuild": "npm run fixtures",
    "build": "tsc --noEmit && vite build && node scripts/standalone.mjs",
    "preview": "vite preview --host 127.0.0.1 --port 4315 --strictPort",
    "test": "vitest run --pool=threads --maxWorkers=1",
    "fixtures": "node --import tsx scripts/fixtures.ts",
    "package": "npm run build && node scripts/package.mjs",
    "test:browser": "node scripts/browser-regression.mjs"
  },
  "dependencies": {
    "fflate": "0.8.3"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "jsdom": "^26.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vitest": "5.0.5"
  }
}
